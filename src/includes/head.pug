    .header_photo
        .info
            #avadiv
                .avatar-flip
                    .avatar-inner
                        img#avatar(src=data.bio.avatar, alt="Ruyuan Wan")
                        img.avatar-back(src="/assets/memoji.jpg", alt="Memoji")
    .header_title
        p.name #{data.bio.name}
        a.cname(href="https://en.wikipedia.org/wiki/N%C3%BCshu" target="_blank" data-tip="My name in Nüshu. Nüshu is a women’s syllabic script from Jiangyong, Hunan, China. Learn more on Wikipedia.")
            each ch in [...data.bio.cname]
                span.cname-char= ch
        p.edu #{data.bio.education} 
        p.edu #{data.bio.affiliation}
        .icons
            a(href='mailto:rjw6289@psu.edu')
                <i class="fa fa-envelope"></i>
            a(target="_blank" href='https://x.com/Ruyuan_Wan')
                <svg class="x-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" aria-label="X"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            a(target="_blank" href='https://www.linkedin.com/in/ruyuan-wan-07804b139/')
